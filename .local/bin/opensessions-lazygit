#!/usr/bin/env sh
# Open opensessions diff actions in LazyGit.
# opensessions normally launches LazyDiff and may pass LazyDiff-only flags like
# --branch; LazyGit rejects those flags, so drop them and open its normal view.
case "${1:-}" in
  ""|--branch|--worktree)
    exec lazygit
    ;;
  *)
    exec lazygit "$@"
    ;;
esac
