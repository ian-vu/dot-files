#!/usr/bin/env bash
set -euo pipefail

repo_root="${DOTFILES_DIR:-}"
if [[ -z "$repo_root" ]]; then
  if git_root=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null); then
    repo_root="$git_root"
  else
    repo_root="$HOME/dot-files"
  fi
fi

manifest="$repo_root/.config/ivu/dotfiles-vendored-skills.tsv"

if [[ ! -f "$manifest" ]]; then
  echo "Manifest not found: $manifest" >&2
  exit 1
fi

while IFS=$'\t' read -r local_path url extra || [[ -n "${local_path:-}" ]]; do
  [[ -z "${local_path:-}" || "$local_path" == \#* ]] && continue

  if [[ -n "${extra:-}" || -z "${url:-}" ]]; then
    echo "Invalid manifest line for $local_path: expected '<local-path><TAB><url>'" >&2
    exit 1
  fi

  destination="$repo_root/$local_path"
  tmp_file=$(mktemp)

  echo "Updating $local_path"
  if ! curl --fail --silent --show-error --location "$url" --output "$tmp_file"; then
    rm -f "$tmp_file"
    exit 1
  fi

  mkdir -p "$(dirname "$destination")"
  mv "$tmp_file" "$destination"
done < "$manifest"

if git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$repo_root" diff -- .claude/skills
fi
