# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# SSH configurations

# Keepalive: sends a packet every N seconds to detect dead connections.
# 0 = disabled (default) — dead connections hang indefinitely until manually killed.
# 60 + CountMax 3 = checks every 60s, drops after 3 missed replies (3 min timeout).
ServerAliveInterval 60
ServerAliveCountMax 3

# Include common config that is used for all hosts
Include config.d/common

# Include common config that is used for this specific host
# Create this file if needed
Match exec "test -f ~/.ssh/config.d/local"
    Include config.d/local
