[user]
	name = Ian Vu
	email = iaanvuu@gmail.com

[push]
	autoSetupRemote = true

[core]
	pager = delta
	excludesfile = /Users/ivu/.gitignore_global
	; Global attributes enable weave without committing .gitattributes to every repo.
	attributesfile = ~/.config/git/attributes
	sshCommand = ssh -i ~/.ssh/id_ed25519_personal

[interactive]
	diffFilter = delta --color-only

[delta]
	line-numbers-right-format = "{np:>4}│ "
  ; Flags show line numbers and remove the left side line numbers since it is duplicated
	line-numbers-left-format = ""
	hunk-header-style = syntax
  line-numbers = true
  tabs = 2

  ; Enable below for side-by-side diff
  ; side-by-side = true

# Delta theme (swap file to change theme)
[include]
	; path = ~/.config/delta/themes/tokyonight-moon.gitconfig
  path = ~/.config/delta/themes/claude-code.gitconfig

[merge]
	conflictstyle = diff3

; Weave resolves supported files with tree-sitter-aware entity-level merges.
[merge "weave"]
	name = Entity-level semantic merge
	driver = /opt/homebrew/bin/weave-driver %O %A %B %L %P

[diff]
	colorMoved = default

# Work-specific config (must be at the end to override core.sshCommand)
[includeIf "gitdir:~/dev/heidi/"]
	path = ~/.gitconfig-heidi

[includeIf "gitdir:~/dev/work/"]
	path = ~/.gitconfig-heidi
[init]
	defaultBranch = main
