{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(sed:*)",
      "Bash(tmux list-keys:*)",
      "Read(//Users/ivu/dev/**)",
      "Bash(git config:*)",
      "Bash(git --version)",
      "Read(//Users/ivu/**)",
      "Bash(cat:*)",
      "Skill(planning-with-files:planning-with-files)",
      "WebFetch(domain:github.com)",
      "Bash(printf:*)",
      "Bash(chmod:*)",
      "Bash(tmux show-hooks:*)",
      "Bash(tmux display-message:*)",
      "Bash(tmux set-hook:*)",
      "Bash(python3:*)",
      "WebSearch",
      "Bash(git show:*)",
      "Bash(tmux:*)",
      "Bash(git stash:*)",
      "WebFetch(domain:neovim.io)",
      "Bash(shellcheck:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/notify_on_finish_script.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/write_summary_of_prompt_to_tmp.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/notify_on_finish_script.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/ensure_running_symbol.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/notify_on_finish_script.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cship"
  },
  "enabledPlugins": {
    "planning-with-files@planning-with-files": false,
    "code-review-graph@code-review-graph": true
  },
  "extraKnownMarketplaces": {
    "code-review-graph": {
      "source": {
        "source": "github",
        "repo": "tirth8205/code-review-graph"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "feedbackSurveyState": {
    "lastShownTime": 1753940027251
  },
  "skipDangerousModePermissionPrompt": true
}
