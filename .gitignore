# Python bytecode caches
__pycache__/
*.py[cod]

# Lockfiles
Brewfile.lock.json
Gemfile.lock

# Local machine-specific Brewfile (create .homebrew/Brewfile.local for machine-specific packages)
.homebrew/Brewfile.local

# age secrey identity used for encryption
.age/secret-key.txt

# Slack MCP session tokens (machine-local plaintext secrets, sourced by .zshrc).
.config/mcp/slack-tokens.env

# vim
.vim/vimrc


# Mac things
**/.DS_Store
.config/vi-mongo/history.txt
# vi-mongo default styles (regenerated on first run)
.config/vi-mongo/styles/
.work-summaries/

# Pi coding-agent session state/auth are local-run artifacts and may contain secrets.
/.pi/agent/sessions/
/.pi/agent/auth.json

# Pi extension LSP dependencies are installed only for local editor support.
/.pi/agent/extensions/node_modules/
