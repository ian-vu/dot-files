{
  // Keep Pi extension LSP clone-location independent: TypeScript resolves imports
  // from this directory's dev-only node_modules instead of hard-coded global paths.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
