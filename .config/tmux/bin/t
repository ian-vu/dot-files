#!/usr/bin/env sh
# ============================================================================
# t — shell entry point for the session system
# ============================================================================
# Thin wrapper that exposes the picker and connect logic as a shell command,
# so reaching a session via `prefix + t` and via `t <name>` go through the
# exact same code paths.
#
# Usage:
#   t              -> open the fzf session picker
#   t <selection>  -> connect by name, saved entry, or filesystem path
#                     (connect.sh decides which)
# ============================================================================

if [ -z "$1" ]; then
  exec "$HOME/.config/tmux/scripts/sessions/picker.sh"
else
  exec "$HOME/.config/tmux/scripts/sessions/connect.sh" "$1"
fi
