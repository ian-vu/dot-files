#!/bin/bash

# This script helps with pane toggling of panes with AI agents.
# The aim is to have the agent running on the left pane.
# The AI pane runs a zsh shell with claude started inside it,
# detected by a tmux pane user option (@is_ai_pane).

ai_process_command="$HOME/.claude/local/claude"
current_pane=$(tmux display-message -p "#{pane_id}")
ai_pane=$(tmux list-panes -F "#{pane_id} #{@is_ai_pane}" | grep -m1 " 1$" | cut -d" " -f1)

# Case 1: No AI pane - split with zsh shell, mark it, and start claude
if [ -z "$ai_pane" ]; then
  tmux split-window -h -l "35%" "zsh -c '$ai_process_command; zsh'"
  tmux set-option -p @is_ai_pane 1

# Case 2: Currently in AI pane - swap to right pane and maximize, effectively hiding AI
elif [[ "$current_pane" == "$ai_pane" ]]; then
  tmux select-pane -R
  tmux resize-pane -Z

# Case 3: AI pane exists and current pane is maximized - go to AI pane directly
elif [[ $(tmux display-message -p "#{window_zoomed_flag}") == "1" ]]; then
  tmux select-pane -t "$ai_pane"

# Case 4: AI pane exists but current pane isn't AI - toggle AI pane size
else
  ai_pane_width=$(tmux display-message -t "$ai_pane" -p "#{pane_width}")
  if [[ "$ai_pane_width" -le 2 ]]; then
    window_width=$(tmux display-message -p "#{window_width}")
    target_width=$((window_width * 35 / 100))
    tmux resize-pane -t "$ai_pane" -x "$target_width"
  else
    tmux resize-pane -t "$ai_pane" -x 1
  fi
fi
