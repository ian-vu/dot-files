#!/usr/bin/env bash
# =============================================================================
# tmux_worktree_add — Create/switch a tmux session for a wt-managed worktree
# =============================================================================
# Tmux owns presentation and session lifecycle. The reusable wt CLI owns git
# worktree creation, .ivu.yml/.ivu.yaml config, and file setup.
#
# Usage:
#   tmux_worktree_add <repo_root> <branch> [session_name]

REPO_ROOT="${1:-}"
BRANCH="${2:-}"
SESSION_OVERRIDE="${3:-}"
# Prefer the stowed binary path so tmux works even if the server has a stale PATH.
if [ -z "${WT_BIN:-}" ]; then
  [ -x "$HOME/.local/bin/wt" ] && WT_BIN="$HOME/.local/bin/wt" || WT_BIN="wt"
fi

if [ -z "$REPO_ROOT" ] || [ -z "$BRANCH" ]; then
  echo "Usage: tmux_worktree_add <repo_root> <branch> [session_name]" >&2
  exit 1
fi

# Colors matching the popup's orange border theme.
ORANGE='\033[1;33m'
GREEN='\033[1;32m'
RED='\033[1;31m'
DIM='\033[2m'
RESET='\033[0m'

LOG_FILE=$(mktemp)
SPIN_RESULT_FILE=$(mktemp)
META_FILE=$(mktemp)
trap 'rm -f "$LOG_FILE" "$SPIN_RESULT_FILE" "$META_FILE"' EXIT

spin_result() { printf '%s' "$1" > "$SPIN_RESULT_FILE"; }

spin() {
  local msg="$1"; shift
  local chars='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  local i=0

  > "$SPIN_RESULT_FILE"
  "$@" >/dev/null 2>>"$LOG_FILE" &
  local pid=$!

  # CSI cursor movement is more reliable than carriage returns in tmux popups.
  while kill -0 "$pid" 2>/dev/null; do
    printf "\033[2K\033[G${ORANGE}%s${RESET} %s" "${chars:$i:1}" "$msg"
    i=$(( (i + 1) % ${#chars} ))
    sleep 0.08
  done

  wait "$pid"
  local rc=$?
  if [ $rc -eq 0 ]; then
    local result=""
    [ -s "$SPIN_RESULT_FILE" ] && result=$(cat "$SPIN_RESULT_FILE")
    if [ -n "$result" ]; then
      printf "\033[2K\033[G${GREEN}✓${RESET} %s ${DIM}→ %s${RESET}\n" "$msg" "$result"
    else
      printf "\033[2K\033[G${GREEN}✓${RESET} %s\n" "$msg"
    fi
  else
    printf "\033[2K\033[G${RED}✗${RESET} %s\n" "$msg"
    return $rc
  fi
}

die() {
  printf "${RED}✗${RESET} %s\n" "$1"
  if [ -s "$LOG_FILE" ]; then
    printf "\n"
    while IFS= read -r line; do
      printf "  ${DIM}%s${RESET}\n" "$line"
    done < "$LOG_FILE"
  fi
  printf "\n${DIM}Press any key to close${RESET}"
  read -rsn1 -t 30 2>/dev/null || sleep 3
  exit 1
}

json_get() {
  python3 - "$META_FILE" "$1" <<'PY'
import json
import sys
with open(sys.argv[1]) as f:
    value = json.load(f).get(sys.argv[2], "")
if value is True:
    print("true")
elif value is False:
    print("false")
elif value is None:
    print("")
else:
    print(value)
PY
}

ensure_worktree() {
  if [ -n "$SESSION_OVERRIDE" ]; then
    "$WT_BIN" worktrees add "$BRANCH" --repo "$REPO_ROOT" --format json --session "$SESSION_OVERRIDE" > "$META_FILE" || return 1
  else
    "$WT_BIN" worktrees add "$BRANCH" --repo "$REPO_ROOT" --format json > "$META_FILE" || return 1
  fi
  local path
  # Treat malformed wt metadata as a setup failure so the popup shows the real
  # wt error instead of creating an empty /wt/ tmux session.
  path=$(json_get worktree_path) || return 1
  if [ -z "$path" ]; then
    echo "wt did not return worktree_path metadata" >&2
    return 1
  fi
  spin_result "${path/#$HOME/~}"
}

# Visual separator between fzf and the progress output below.
echo ""

spin "Preparing worktree" ensure_worktree || die "Failed to prepare worktree"

WORKTREE_PATH=$(json_get worktree_path)
WORKTREE_DIR=$(json_get worktree_dir)
REPO_SAFE_NAME=$(json_get repo_safe_name)
STARTUP_CMD=$(json_get startup_cmd)
SUPPRESS_HOOK=$(json_get suppress_tmux_startup_hook)
CONFIG_CREATED=$(json_get config_created)
CREATED=$(json_get created)
SESSION=$(json_get session_name)
# Preserve the long-standing convention unless the caller supplied an explicit
# tmux session name through wt/tmux_worktree.
[ -n "$SESSION" ] || SESSION="$REPO_SAFE_NAME/wt/$WORKTREE_DIR"
STALE_SESSION=""

if [ "$CONFIG_CREATED" = "true" ]; then
  printf "${GREEN}✓${RESET} Created .ivu.yml from template\n"
fi

session_has_missing_cwd() {
  local pane_path
  while IFS= read -r pane_path; do
    # If a worktree was removed outside wt (for example from LazyGit), tmux can
    # keep panes whose process cwd no longer exists. Reusing that session makes
    # tools like LazyGit panic on their next git refresh, so replace it instead.
    [ -n "$pane_path" ] && [ -d "$pane_path" ] && continue
    return 0
  done < <(tmux list-panes -s -t "=$1" -F '#{pane_current_path}' 2>/dev/null || true)
  return 1
}

replace_existing_session() {
  local reason="$1"
  STALE_SESSION="$SESSION-stale-$$"
  printf "${GREEN}✓${RESET} Replacing stale tmux session %s ${DIM}(%s)${RESET}\n" "$SESSION" "$reason"
  tmux rename-session -t "=$SESSION" "$STALE_SESSION" || return 1
}

if tmux has-session -t "=$SESSION" 2>/dev/null; then
  if [ "$CREATED" = "true" ]; then
    replace_existing_session "worktree was recreated" || die "Failed to replace stale session"
  elif session_has_missing_cwd "$SESSION"; then
    replace_existing_session "pane cwd disappeared" || die "Failed to replace stale session"
  else
    printf "${GREEN}✓${RESET} Switching to %s\n" "$SESSION"
    sleep 0.3
    tmux switch-client -t "=$SESSION"
    exit 0
  fi
fi

cleanup_stale_session() {
  [ -n "$STALE_SESSION" ] || return 0
  tmux kill-session -t "=$STALE_SESSION" 2>/dev/null || true
}

create_session() {
  local start_pane
  if [ "$SUPPRESS_HOOK" = "true" ]; then
    # wt returns the config value; tmux alone decides how it affects sessions.
    # Capture the first pane id so send-keys targets a pane, not just a session.
    start_pane=$(TMUX_NO_STARTUP_HOOK=1 tmux new-session -d -P -F '#{pane_id}' -s "$SESSION" -c "$WORKTREE_PATH")
  else
    # Capture the first pane id so startup commands work for exact session names
    # containing slashes; tmux send-keys cannot target a bare session name.
    start_pane=$(tmux new-session -d -P -F '#{pane_id}' -s "$SESSION" -c "$WORKTREE_PATH")
  fi
  if [ -z "$start_pane" ]; then
    echo "tmux did not return a startup pane for session: $SESSION" >&2
    return 1
  fi

  if [ -n "$STARTUP_CMD" ]; then
    tmux send-keys -t "$start_pane" "$STARTUP_CMD" Enter || return 1
  fi

  spin_result "$SESSION"
}

spin "Starting session" create_session || die "Failed to create session"

printf "${GREEN}✓${RESET} Switching to %s 🌳\n" "$SESSION"
sleep 0.3
tmux switch-client -t "=$SESSION"
cleanup_stale_session
