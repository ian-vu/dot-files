#!/usr/bin/env bash
# =============================================================================
# tmux_worktree_pick_repo — tmux/fzf repository picker backed by wt
# =============================================================================
# wt owns repository discovery, cache, and pins. This script only renders the
# picker and returns the selected absolute path for tmux_worktree.

SCRIPT_PATH="$0"
# Prefer the stowed binary path so tmux works even if the server has a stale PATH.
if [ -z "${WT_BIN:-}" ]; then
  [ -x "$HOME/.local/bin/wt" ] && WT_BIN="$HOME/.local/bin/wt" || WT_BIN="wt"
fi
DEV_DIR="$HOME/dev"
ACTION="pick"
TOGGLE_REPO=""
PIN_ICON="📌"

while [ $# -gt 0 ]; do
  case "$1" in
    --list) ACTION="list"; shift ;;
    --toggle) ACTION="toggle"; TOGGLE_REPO="$2"; shift 2 ;;
    *) DEV_DIR="$1"; shift ;;
  esac
done

case "$ACTION" in
  list)
    "$WT_BIN" repos list --dev-dir "$DEV_DIR" --format fzf
    exit 0
    ;;
  toggle)
    "$WT_BIN" repos pin toggle "$TOGGLE_REPO"
    exit 0
    ;;
esac

SELECTED=$(
  "$WT_BIN" repos list --dev-dir "$DEV_DIR" --format fzf | fzf \
    --layout reverse --info right \
    --no-border \
    --prompt '  repo: ' \
    --pointer ' ➜' --color "gutter:#222436,border:#ff966c,label:#ff966c" \
    --bind 'tab:down,btab:up' \
    --bind "ctrl-g:execute-silent('$SCRIPT_PATH' --toggle {-1} '$DEV_DIR')+reload('$SCRIPT_PATH' --list '$DEV_DIR')" \
    --header 'C-g Pin'
) || true

if [ -n "$SELECTED" ]; then
  SELECTED="${SELECTED#$PIN_ICON }"
  SELECTED="${SELECTED#  }"
  echo "$DEV_DIR/$SELECTED"
fi
