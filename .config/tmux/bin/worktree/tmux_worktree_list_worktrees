#!/usr/bin/env bash
# =============================================================================
# tmux_worktree_list_worktrees — compatibility wrapper around wt worktrees list
# =============================================================================
# Historical callers pass <base_branch> <wt_dir> [repo_root]. wt now reads those
# values from .ivu.yml/.ivu.yaml, so only repo_root is forwarded when present.

# Prefer the stowed binary path so tmux works even if the server has a stale PATH.
if [ -z "${WT_BIN:-}" ]; then
  [ -x "$HOME/.local/bin/wt" ] && WT_BIN="$HOME/.local/bin/wt" || WT_BIN="wt"
fi

# Preserve the old positional interface: base and wt_dir are ignored by design.
shift 2 2>/dev/null || true

if [ -n "${1:-}" ]; then
  "$WT_BIN" worktrees list --repo "$1" --format fzf
else
  "$WT_BIN" worktrees list --format fzf
fi
