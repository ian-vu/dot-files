#!/usr/bin/env bash
# =============================================================================
# tmux_worktree — Git worktree picker popup
# =============================================================================
# Entry point for the worktree workflow, bound to: prefix + w
#
# Opens a tmux floating popup that wraps the entire lifecycle:
#   1. Optional direct branch/PR URL input with session-name override
#   2. Mode-switching fzf picker (branch or worktree view)
#   3. Dispatches to tmux_worktree_add (create) or tmux_worktree_rm (remove)
#
# The popup uses display-popup -E which keeps it open until the inner command
# exits. When called with --inner, runs the picker loop directly (inside the
# popup). Without --inner, opens the popup calling itself.

# Resolve this script's directory so we can call sibling scripts by absolute
# path. Needed because this directory is NOT on $PATH — it's a subdirectory
# of ~/.config/tmux/bin/ that only contains worktree-related scripts.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Prefer the stowed binary path so tmux works even if the server has a stale PATH.
if [ -z "${WT_BIN:-}" ]; then
  [ -x "$HOME/.local/bin/wt" ] && WT_BIN="$HOME/.local/bin/wt" || WT_BIN="wt"
fi

trim_value() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

# Parse the direct/prompt form. One token keeps the historical behavior and is
# treated as the branch/PR URL; two tokens mean session name first, branch/URL
# second.
parse_branch_args() {
  PARSED_SESSION=""
  PARSED_BRANCH=""

  if [ $# -eq 0 ]; then
    return 0
  fi

  if [ $# -eq 1 ]; then
    local raw first second rest
    raw=$(trim_value "$1")
    [ -z "$raw" ] && return 0
    read -r first second rest <<< "$raw"
    [ -z "${rest:-}" ] || return 1
    if [ -n "${second:-}" ]; then
      PARSED_SESSION="$first"
      PARSED_BRANCH="$second"
    else
      PARSED_BRANCH="$first"
    fi
    return 0
  fi

  if [ $# -eq 2 ]; then
    PARSED_SESSION=$(trim_value "$1")
    PARSED_BRANCH=$(trim_value "$2")
    return 0
  fi

  return 1
}

shell_join() {
  local arg quoted joined=""
  for arg in "$@"; do
    printf -v quoted '%q' "$arg"
    joined="${joined:+$joined }$quoted"
  done
  printf '%s' "$joined"
}

usage_hint() {
  printf 'Use: <branch|pr-url> or <session> <branch|pr-url>\n'
}

# =============================================================================
# Popup launcher (outer mode)
# =============================================================================
# When called without --inner, resolve the repo root and open the popup.
if [ "${1:-}" != "--inner" ]; then
  pane_path=""
  branch_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --pane-path)
        [ -n "${2:-}" ] || { tmux display-message "wt: --pane-path requires a path"; exit 1; }
        pane_path="$2"
        shift 2
        ;;
      --)
        shift
        branch_args+=("$@")
        break
        ;;
      *)
        branch_args+=("$1")
        shift
        ;;
    esac
  done

  # The tmux binding passes the triggering pane path so the popup resolves the
  # same repo the user was looking at. Parse it before branch input so paths are
  # not mistaken for branch names.
  if ! parse_branch_args "${branch_args[@]}"; then
    tmux display-message "wt: $(usage_hint)"
    exit 1
  fi
  requested_session="$PARSED_SESSION"
  requested_branch="$PARSED_BRANCH"

  # Resolve the git repo root from whichever directory the user's active pane is in.
  # wt centralizes this so plain CLI and tmux entry points handle linked
  # worktrees the same way.
  [ -n "$pane_path" ] || pane_path=$(tmux display-message -p -F "#{pane_current_path}")
  repo_root=""
  # Delegate repo-root detection to wt so tmux and non-tmux entry points agree
  # about resolving linked worktrees back to the main repository.
  repo_root=$("$WT_BIN" root "$pane_path" 2>/dev/null || true)

  # Direct branch/URL input skips fzf but still uses a popup so progress and
  # errors stay visible. Empty input opens the normal picker below.
  if [ -n "$requested_branch" ]; then
    if [ -z "$repo_root" ]; then
      tmux display-message "wt: open a repo pane, or submit empty input to pick a repo"
      exit 1
    fi
    if [ -n "$requested_session" ]; then
      popup_cmd=$(shell_join "$SCRIPT_DIR/tmux_worktree_add" "$repo_root" "$requested_branch" "$requested_session")
    else
      popup_cmd=$(shell_join "$SCRIPT_DIR/tmux_worktree_add" "$repo_root" "$requested_branch")
    fi
  else
    # Calls itself with --inner to run the picker loop inside the popup.
    popup_cmd=$(shell_join "$SCRIPT_DIR/tmux_worktree" --inner "$repo_root")
  fi

  # Open the popup:
  #   -b rounded -S fg=#ff966c  Orange rounded border (matches tmux_float style)
  #   -T ' Git Worktree '       Title rendered in the border
  #   -d "$repo_root"           Set CWD to repo root for git commands (omitted when empty)
  #   -E                        Close popup when the inner command exits
  #   -w 80 -h 40%              Fixed 80 columns wide, 40% of terminal height
  tmux display-popup \
    -b rounded -S fg=#ff966c -T '#[align=centre] Git Worktree ' \
    ${repo_root:+-d "$repo_root"} \
    -E -w 80 -h 40% \
    "$popup_cmd"
  exit 0
fi

# =============================================================================
# Picker loop (inner mode — runs inside the popup)
# =============================================================================
shift  # consume --inner
REPO_ROOT="$1"
DEV_DIR="$HOME/dev"

# Colors matching the popup's orange border theme
GREEN='\033[1;32m'
RESET='\033[0m'

# Build an fzf header with a horizontal rule sized to the text.
# Usage: header_with_rule "text"
header_with_rule() {
  local text="$1"
  printf '%s\n%s' "$text" "$(printf '─%.0s' $(seq 1 ${#text}))"
}

# Determine initial mode: branch picker if in a repo, repo picker if not.
if [ -z "$REPO_ROOT" ]; then
  MODE="repo"
else
  MODE="branch"
fi

while true; do
  # -----------------------------------------------------------------
  # Mode: repo — pick a repository from ~/dev
  # -----------------------------------------------------------------
  if [ "$MODE" = "repo" ]; then
    REPO_ROOT=$("$SCRIPT_DIR/tmux_worktree_pick_repo" "$DEV_DIR")
    [ -z "$REPO_ROOT" ] && exit 0
    MODE="branch"
    continue
  fi

  # Derive repo-dependent state at the top of each iteration so that
  # switching repos via ctrl-p correctly updates fzf context.
  cd "$REPO_ROOT"
  REPO_NAME=$(basename "$REPO_ROOT")
  REPO_NAME="${REPO_NAME//./-}"
  REPO_NAME="${REPO_NAME//:/-}"
  # Color the repo name orange (matching the popup border theme) to
  # visually distinguish it from the mode label (branch/worktree).
  REPO_LABEL=$'\033[38;2;255;150;108m'"[$REPO_NAME]"$'\033[0m'

  # -----------------------------------------------------------------
  # Mode: branch — pick or type a branch name to create a worktree
  # -----------------------------------------------------------------
  if [ "$MODE" = "branch" ]; then
    FZF_OUTPUT=$(
      fzf < /dev/null \
        --height 100% \
        --layout reverse --info right --keep-right --no-sort \
        --no-border \
        --prompt "  $REPO_LABEL New branch: " \
        --pointer ' ➜' --color "gutter:#222436,border:#ff966c,label:#ff966c" \
        --print-query \
        --expect=ctrl-p,ctrl-w \
        --bind "ctrl-b:change-prompt(  $REPO_LABEL Existing branch: )+reload:'$WT_BIN' branches --repo '$REPO_ROOT' --fetch" \
        --header "$(header_with_rule '⌨ <c-p> Repos | <c-b> Branches | <c-w> Worktrees')"
    ) || true

    QUERY=$(sed -n '1p' <<< "$FZF_OUTPUT")
    KEY=$(sed -n '2p' <<< "$FZF_OUTPUT")
    SELECTED=$(sed -n '3p' <<< "$FZF_OUTPUT")

    case "$KEY" in
      ctrl-p) MODE="repo"; continue ;;
      ctrl-w) MODE="worktree"; continue ;;
    esac

    SESSION_OVERRIDE=""
    if [ -n "$SELECTED" ]; then
      BRANCH="$SELECTED"
    else
      if ! parse_branch_args "$QUERY"; then
        printf '\n'
        usage_hint
        sleep 2
        exit 1
      fi
      BRANCH="$PARSED_BRANCH"
      SESSION_OVERRIDE="$PARSED_SESSION"
    fi

    # Trim leading/trailing whitespace — pasted branch names often carry stray
    # spaces, and git rejects refs containing whitespace, which previously
    # produced a half-created worktree directory with no checkout.
    BRANCH="${BRANCH#"${BRANCH%%[![:space:]]*}"}"
    BRANCH="${BRANCH%"${BRANCH##*[![:space:]]}"}"
    [ -z "$BRANCH" ] && exit 0

    # Hand off to tmux_worktree_add for creation + session + switch.
    # exec replaces this process so the popup stays open for the spinner
    # and closes when tmux_worktree_add exits.
    if [ -n "$SESSION_OVERRIDE" ]; then
      exec "$SCRIPT_DIR/tmux_worktree_add" "$REPO_ROOT" "$BRANCH" "$SESSION_OVERRIDE"
    else
      exec "$SCRIPT_DIR/tmux_worktree_add" "$REPO_ROOT" "$BRANCH"
    fi
  fi

  # -----------------------------------------------------------------
  # Mode: worktree — select worktrees to remove
  # -----------------------------------------------------------------
  if [ "$MODE" = "worktree" ]; then
    FZF_OUTPUT=$(
      "$WT_BIN" worktrees list --repo "$REPO_ROOT" --format fzf \
      | fzf \
        --height 100% \
        --layout reverse --info right --keep-right --no-sort \
        --no-border \
        --prompt "🌳 $REPO_LABEL worktree: " \
        --pointer ' ➜' --color "gutter:#222436,border:#ff966c,label:#ff966c" \
        --multi --marker ' ' \
        --print-query \
        --expect=ctrl-p,ctrl-b \
        --bind 'tab:toggle+down,btab:toggle+up' \
        --bind "ctrl-x:execute-silent(for d in {+-1}; do '$SCRIPT_DIR/tmux_worktree_rm' '$REPO_ROOT' \"\$d\"; done)+reload:'$WT_BIN' worktrees list --repo '$REPO_ROOT' --format fzf" \
        --header "$(header_with_rule '⌨ <c-p> Repos | <c-b> Branches | <enter> Remove | <c-x> Remove+stay')"
    ) || true

    KEY=$(sed -n '2p' <<< "$FZF_OUTPUT")

    case "$KEY" in
      ctrl-p) MODE="repo"; continue ;;
      ctrl-b) MODE="branch"; continue ;;
    esac

    # Enter — remove all selected worktrees and close the popup.
    echo ""
    tail -n +3 <<< "$FZF_OUTPUT" | while IFS= read -r item; do
      item="${item# }"
      item="${item#⎇ }"
      item="${item#  }"
      [ -z "$item" ] && continue
      "$SCRIPT_DIR/tmux_worktree_rm" "$REPO_ROOT" "$item"
      printf "${GREEN}✓${RESET} Removed %s\n" "$item"
    done
    sleep 0.5
    exit 0
  fi
done
