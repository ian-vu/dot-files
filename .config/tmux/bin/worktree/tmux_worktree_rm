#!/usr/bin/env bash
# =============================================================================
# tmux_worktree_rm — Remove a wt-managed worktree and its tmux session
# =============================================================================
# Tmux owns killing the session; wt owns git worktree removal and pruning.
#
# Usage: tmux_worktree_rm <repo_root> <worktree_dir>

set -e

REPO_ROOT="$1"
WORKTREE_DIR="$2"
# Prefer the stowed binary path so tmux works even if the server has a stale PATH.
if [ -z "${WT_BIN:-}" ]; then
  [ -x "$HOME/.local/bin/wt" ] && WT_BIN="$HOME/.local/bin/wt" || WT_BIN="wt"
fi

if [ -z "$REPO_ROOT" ] || [ -z "$WORKTREE_DIR" ]; then
  echo "Usage: tmux_worktree_rm <repo_root> <worktree_dir>" >&2
  exit 1
fi

# Strip fzf status prefixes before deriving tmux session names or calling wt.
WORKTREE_DIR="${WORKTREE_DIR# }"
WORKTREE_DIR="${WORKTREE_DIR#⎇ }"
WORKTREE_DIR="${WORKTREE_DIR#  }"

REPO_NAME=$(basename "$REPO_ROOT")
REPO_NAME="${REPO_NAME//./-}"
REPO_NAME="${REPO_NAME//:/-}"
SESSION="$REPO_NAME/wt/$WORKTREE_DIR"

worktree_path_for_dir() {
  "$WT_BIN" worktrees list --repo "$REPO_ROOT" --format json 2>/dev/null \
    | python3 -c 'import json, sys
wanted = sys.argv[1]
for item in json.load(sys.stdin):
    if item.get("worktree_dir") == wanted:
        print(item.get("worktree_path", ""))
        break
' "$1"
}

kill_sessions_for_path() {
  local worktree_path="$1" format session_name session_path
  [ -n "$worktree_path" ] || return 0
  # Custom session names cannot be derived from the worktree directory, so kill
  # any tmux session whose session_path is the worktree being removed.
  format="#{session_name}"$'\t'"#{session_path}"
  while IFS=$'\t' read -r session_name session_path; do
    [ "$session_path" = "$worktree_path" ] || continue
    tmux kill-session -t "=$session_name" 2>/dev/null || true
  done < <(tmux list-sessions -F "$format" 2>/dev/null || true)
}

WORKTREE_PATH=$(worktree_path_for_dir "$WORKTREE_DIR" || true)
kill_sessions_for_path "$WORKTREE_PATH"

# Exact session matching preserves the default-name behavior and also covers
# stale sessions whose session_path is unavailable.
if tmux has-session -t "=$SESSION" 2>/dev/null; then
  tmux kill-session -t "=$SESSION"
fi

"$WT_BIN" worktrees rm "$WORKTREE_DIR" --repo "$REPO_ROOT" >/dev/null
