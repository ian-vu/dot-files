#!/usr/bin/env bash
# =============================================================================
# tmux_worktree_list_branches — compatibility wrapper around wt branches
# =============================================================================
# Kept so older tmux/fzf bindings can still call this script while wt owns the
# branch listing and optional background fetch behavior.

# Prefer the stowed binary path so tmux works even if the server has a stale PATH.
if [ -z "${WT_BIN:-}" ]; then
  [ -x "$HOME/.local/bin/wt" ] && WT_BIN="$HOME/.local/bin/wt" || WT_BIN="wt"
fi
FETCH=false
if [ "${1:-}" = "--fetch" ]; then
  FETCH=true
  shift
fi

REPO_ARGS=()
[ -n "${1:-}" ] && REPO_ARGS=(--repo "$1")

if [ "$FETCH" = true ]; then
  "$WT_BIN" branches "${REPO_ARGS[@]}" --fetch
else
  "$WT_BIN" branches "${REPO_ARGS[@]}"
fi
